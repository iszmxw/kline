#!/bin/sh

# 一键打包服务

# 1、打包api接口
GOOS=linux GOARCH=amd64 go build -o build/apiService main.go

# 2、打包 火币网 K线图socket采集服务
GOOS=linux GOARCH=amd64 go build -o build/huobiService service/kline-huobi/main.go

## 3、打包 新浪 K线图采集服务
#GOOS=linux GOARCH=amd64 go build -o build/sinaService service/kline-sina/main.go

# 4、打包 raceoption K线图socket采集服务
GOOS=linux GOARCH=amd64 go build -o build/raceoptionService service/kline-raceoption/main.go

## 5、打包实时赔率计算服务
#GOOS=linux GOARCH=amd64 go build -o build/liveoddsService service/liveodds/calculate.go

# 6、打包 kline-olymptrade K线图socket采集服务
GOOS=linux GOARCH=amd64 go build -o build/olymptradeService service/kline-olymptrade/main.go

# 7、打包 kline-hsb K线图socket采集服务
GOOS=linux GOARCH=amd64 go build -o build/hsbService service/kline-hsb/main.go

# 8、打包 kline-binance K线图socket采集服务
GOOS=linux GOARCH=amd64 go build -o build/binanceService service/kline-binance/main.go

# 9、打包 kline-qxbroker K线图socket采集服务
GOOS=linux GOARCH=amd64 go build -o build/qxbrokerService service/kline-qxbroker/main.go
