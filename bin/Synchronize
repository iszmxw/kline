#!/bin/bash

echo -e "\033[35m 准备开始同步... \033[0m"

PWD=$(pwd)

IP=$(curl -s ip.sb)

echo "您当前的服务器ip：$IP"

if [[ -n "$IP" && "$IP" = "47.242.235.4" ]]; then
    # shellcheck disable=SC2164
    cd /home/yezhiming/work
    rm -rf binary-system/
    rm -rf smart-trade/
    git clone -b smt http://8.129.23.111:5720/buss/binary-system.git
    git clone http://8.129.23.111:5720/yezhiming/smart-trade.git
    rm -rf binary-system/.git
    cp -r binary-system/* smart-trade/
    # shellcheck disable=SC2164
    cd smart-trade/
    git add .
    git commit -m '同步代码'
    git push
else
    echo "IP address doesn't match"
fi

pwd

