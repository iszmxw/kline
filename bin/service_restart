#!/bin/sh

# 重启 apiService
apiService=$(ps -ef|grep "/apiService" | grep -v "grep" | awk hh'{print $2}')
if [ "$apiService" ]
then
  kill -9 "$apiService"
  nohup ./apiService > /dev/null 2>&1 & echo $!>logs/apiService.pid
else
  nohup ./apiService > /dev/null 2>&1 & echo $!>logs/apiService.pid
fi

