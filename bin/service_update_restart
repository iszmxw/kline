#!/bin/sh

# 重启 apiService
apiService=$(ps -ef|grep "/apiService-running" | grep -v "grep" | awk hh'{print $2}')
if [ "$apiService" ]
then
  kill -9 "$apiService"
  \cp -rf apiService apiService-running
  nohup ./apiService-running > /dev/null 2>&1 & echo $!>logs/apiService-running.pid
else
  \cp -rf apiService apiService-running
  nohup ./apiService-running > /dev/null 2>&1 & echo $!>logs/apiService-running.pid
fi

